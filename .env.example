# Browser configuration (public). Set both explicitly for the intended project.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# Server only; never prefix these with REACT_APP_ or VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CCA_MERCHANT_ID=
CCA_WORKING_KEY=
CCA_ACCESS_CODE=
CCA_ENVIRONMENT=sandbox
SITE_URL=http://127.0.0.1:3000
# Enable only after the database migration and service cutover have passed staging checks.
SECURE_CHECKOUT_ENABLED=false
CCA_CALLBACKS_ENABLED=false
REACT_APP_GA_MEASUREMENT_ID=
# Set only after verifying the hosting project and production branch with the owner.
STORE_PRODUCTION_BRANCH=
# Server permission and storefront visibility for owner-approved COD.
STORE_COD_ENABLED=false
REACT_APP_COD_ENABLED=false

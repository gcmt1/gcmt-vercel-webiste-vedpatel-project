{
  "name": "gcmt-website",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://gcmtshop.com/",
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "0.503.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "2.0.5",
    "react-icons": "5.5.0",
    "react-router-dom": "7.18.5",
    "web-vitals": "2.1.4"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:security": "vitest run tests/security tests/server",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm test && npm run build && npm audit --omit=dev --audit-level=high",
    "prebuild": "node scripts/check-environment.mjs",
    "release:check": "node scripts/check-environment.mjs --release",
    "format:check": "prettier --check \"{api,server,scripts,tests}/**/*.{js,mjs,jsx}\" vite.config.js playwright.config.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "fflate": "0.8.3",
    "lodash": "4.18.1"
  }
}
